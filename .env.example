# Copy to .env and fill in. .env is gitignored.
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Only set this if you route OpenRouter through your own gateway.
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Needed by `career-copilot sources discover`, which refuses to run without it.
# Create a key at https://app.tavily.com
TAVILY_API_KEY=

# Needed only by `career-copilot sources sync --from notion`.
# Create an internal integration at https://www.notion.so/my-integrations, then share
# the target database with it in Notion: open the database, ... > Connections > add it.
# The token alone cannot see a database that has not been shared.
NOTION_API_KEY=
